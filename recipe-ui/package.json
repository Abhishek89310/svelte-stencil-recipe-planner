{
  "name": "@iosdev_89/recipe-ui",
  "version": "0.1.0",
  "description": "Reusable web component library for recipe discovery and meal planning interfaces, built with StencilJS.",
  "license": "MIT",
  "keywords": [
    "web-components",
    "stencil",
    "custom-elements",
    "recipe",
    "meal-planner",
    "ui-library"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-ui/recipe-ui.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/recipe-ui/recipe-ui.css": "./dist/recipe-ui/recipe-ui.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "loader/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test.watch": "stencil test --spec --watchAll",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stencil/core": "^4.44.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
